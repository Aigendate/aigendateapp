# Copy to .env and fill in. .env is gitignored.

# --- Local development (docker compose up -d postgres) ---
# Local Postgres runs on host port 5434 (see docker-compose.yml).
DATABASE_URL="postgresql://turnos:turnos@localhost:5434/turnos?schema=public"
# Direct (non-pooled) connection used by migrations. Same as DATABASE_URL locally.
DIRECT_URL="postgresql://turnos:turnos@localhost:5434/turnos?schema=public"
# Isolated test DB (created via `npm run db:test:setup`). Used by the test suite.
DATABASE_URL_TEST="postgresql://turnos:turnos@localhost:5434/turnos_test?schema=public"

# --- Production (Vercel + Supabase) ---
# DATABASE_URL  -> Supabase pgbouncer transaction pooler (port 6543). Used by the app runtime.
# DIRECT_URL    -> Supabase direct connection (port 5432). Used by migrations; pgbouncer
#                  breaks the advisory locks and DDL the migrator relies on.
# DATABASE_URL="postgresql://USER:PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://USER:PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres"
