# Copy to .env and fill in. .env is gitignored.

# --- Local development (docker compose up -d postgres) ---
# Local Postgres runs on host port 5434 (see docker-compose.yml).
DATABASE_URL="postgresql://turnos:turnos@localhost:5434/turnos?schema=public"
# Direct (non-pooled) connection used by migrations. Same as DATABASE_URL locally.
DIRECT_URL="postgresql://turnos:turnos@localhost:5434/turnos?schema=public"
# Isolated test DB (created via `npm run db:test:setup`). Used by the test suite.
DATABASE_URL_TEST="postgresql://turnos:turnos@localhost:5434/turnos_test?schema=public"

# --- Production (Vercel + Supabase) ---
# DATABASE_URL  -> Supabase pgbouncer transaction pooler (port 6543). Used by the app runtime.
# DIRECT_URL    -> Supabase direct connection (port 5432). Used by migrations; pgbouncer
#                  breaks the advisory locks and DDL the migrator relies on.
# DATABASE_URL="postgresql://USER:PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://USER:PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# --- Vapi voice assistant ---
# VAPI_API_KEY: private key used by scripts/vapi-setup.ts to create the assistant.
VAPI_API_KEY=""
# VAPI_SERVER_SECRET: shared secret. Set the same value as the tool server.secret
# in Vapi and as a Vercel env var so /api/vapi can verify inbound tool calls.
# Leave unset to disable the check (e.g. local dev).
VAPI_SERVER_SECRET=""
# NEXT_PUBLIC_VAPI_PUBLIC_KEY: the *public* key (Vapi dashboard -> API Keys ->
# Public Key). Safe to ship to the browser; powers the /asistente voice UI.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=""
# NEXT_PUBLIC_VAPI_ASSISTANT_ID: assistant the web UI connects to. Defaults to
# the live "Turnos" assistant if unset.
NEXT_PUBLIC_VAPI_ASSISTANT_ID=""

# --- Clerk auth (gates the /admin section only) ---
# Keys from dashboard.clerk.com -> API keys. Use pk_test_/sk_test_ locally,
# pk_live_/sk_live_ in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Where Clerk's <SignIn /> lives, and where to land after sign-in.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/admin"
# Comma-separated allowlist of emails permitted into /admin. A signed-in user
# whose verified email is NOT here is bounced back to /sign-in (fail-closed:
# if unset, nobody can reach admin). Enable email magic-link/OTP + Google in
# the Clerk dashboard, and restrict sign-up to these same emails there.
ADMIN_EMAILS=""

# --- ElevenLabs Agents voice assistant ("Lucía") ---
# ELEVENLABS_API_KEY: account key used by elevenlabs-setup.ts to create the agent
# + tools, and by /api/elevenlabs-token to mint a signed URL for the browser.
ELEVENLABS_API_KEY=""
# ELEVENLABS_AGENT_ID: printed by `npm run elevenlabs:setup`. Used server-side to
# mint the signed URL. Re-running setup with this set PATCHes the agent.
ELEVENLABS_AGENT_ID=""
# NEXT_PUBLIC_ELEVENLABS_AGENT_ID: browser fallback if the signed-URL endpoint is
# unavailable (only works if the agent is public). Usually the same id as above.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=""
# ELEVENLABS_WEBHOOK_SECRET: optional shared secret. When set, setup wires it as an
# `x-elevenlabs-secret` header on each tool and /api/elevenlabs verifies it.
ELEVENLABS_WEBHOOK_SECRET=""
# ELEVENLABS_WEBHOOK_URL: public base URL ElevenLabs calls for tools (no localhost;
# use the deployed URL or an ngrok tunnel). Defaults to https://aigendate.vercel.app
ELEVENLABS_WEBHOOK_URL=""
# Optional overrides for the agent voice/model (sensible defaults in setup script):
# ELEVENLABS_VOICE_ID (default Kate 2, LatAm Spanish), ELEVENLABS_TTS_MODEL
# (default eleven_flash_v2_5), ELEVENLABS_LLM (default gemini-2.5-flash).
ELEVENLABS_VOICE_ID=""
ELEVENLABS_TTS_MODEL=""
ELEVENLABS_LLM=""
