{
  "name": "turnos",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "react-router build",
    "start": "NODE_ENV=production node build/server/index.js",
    "mcp:stdio": "node --import tsx mcp-stdio.ts",
    "seed": "node --import tsx seed.ts",
    "scrape": "python3 scraper/paraguay_hospitals.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@react-router/dev": "^7.15.0",
    "@react-router/express": "^7.15.0",
    "@react-router/node": "^7.15.0",
    "@tailwindcss/vite": "^4.2.4",
    "better-sqlite3": "^11.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.15.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "vite": "^8.0.10",
    "zod": "^3.23.0",
    "isbot": "^5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  }
