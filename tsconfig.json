{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "~/*": ["./app/*"]
    }
  },
  "include": ["next-env.d.ts", "app/**/*", "server/**/*", "tests/**/*", "*.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
