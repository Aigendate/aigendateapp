generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Hospital {
  id           String        @id @default(uuid())
  name         String
  address      String
  lat          Float
  lng          Float
  appointments Appointment[]
  doctors      Doctor[]

  @@map("hospitals")
}

model Patient {
  id              String          @id @default(uuid())
  name            String
  email           String?         @unique
  phone           String?
  created_at      DateTime        @default(now())
  appointments    Appointment[]
  waitlist_entries WaitlistEntry[]

  @@map("patients")
}

model Doctor {
  id              String           @id @default(uuid())
  name            String
  specialty       String
  hospital_id     String
  appointments    Appointment[]
  hospital        Hospital         @relation(fields: [hospital_id], references: [id])
  schedules       DoctorSchedule[]
  waitlist_entries WaitlistEntry[]

  @@map("doctors")
}

model DoctorSchedule {
  id         String @id @default(uuid())
  doctor_id  String
  day_of_week Int   // 0=domingo, 1=lunes ... 6=sabado
  start_time String // "08:00"
  end_time   String // "17:00"
  slot_duration Int @default(30) // minutos por turno
  doctor     Doctor @relation(fields: [doctor_id], references: [id])

  @@unique([doctor_id, day_of_week])
  @@map("doctor_schedules")
}

model Appointment {
  id                    String        @id @default(uuid())
  hospital_id           String
  patient_id            String
  doctor_id             String
  date                  String
  time                  String
  duration              Int           @default(30) // minutos
  status                String        @default("scheduled") // scheduled, cancelled, completed, no_show
  is_recurring          Boolean       @default(false)
  recurrence_rule       String?       // "weekly:2" = cada 2 semanas
  parent_appointment_id String?
  created_at            DateTime      @default(now())
  doctor                Doctor        @relation(fields: [doctor_id], references: [id])
  patient               Patient       @relation(fields: [patient_id], references: [id])
  hospital              Hospital      @relation(fields: [hospital_id], references: [id])

  @@map("appointments")
}

model WaitlistEntry {
  id           String   @id @default(uuid())
  patient_id   String
  doctor_id    String?  // null = cualquier doctor de la especialidad
  specialty    String
  date_from    String   // rango de fechas deseado
  date_to      String
  time_pref    String?  // "morning", "afternoon", o null = cualquiera
  priority     Int      @default(0) // mayor = mas urgente
  status       String   @default("waiting") // waiting, offered, accepted, expired
  created_at   DateTime @default(now())
  patient      Patient  @relation(fields: [patient_id], references: [id])
  doctor       Doctor?  @relation(fields: [doctor_id], references: [id])

  @@map("waitlist_entries")
}
